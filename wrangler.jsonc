{
  // Cloudflare Worker "audiovox": serves this folder as the static site and runs
  // worker/index.js for /api/* (the booking form -> Resend relay).
  "name": "audiovox",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Only /api/* goes through the worker; everything else is served straight from the files.
    "run_worker_first": ["/api/*"]
  },
  // D1 database for the song-request list. No database_id on purpose: Cloudflare
  // creates it automatically on the first deploy. The tables are created by
  // worker/songs.js on first use.
  "d1_databases": [{ "binding": "DB", "database_name": "audiovox-songs" }],
  // Keep the variables and secrets set in the Cloudflare dashboard
  // (RESEND_API_KEY, BOOKING_TO, BOOKING_FROM) when deploying from GitHub.
  "keep_vars": true,
  "observability": { "enabled": true }
}
