{
  // Cloudflare Worker "audiovox": serves this folder as the static site and runs
  // worker/index.js for /api/* (the booking form -> Resend relay).
  "name": "audiovox",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Only /api/*, uploaded photos (/media/*) and the home page (/, to apply the flyer settings) go through the
    // worker; everything else is served straight from the files.
    "run_worker_first": ["/", "/api/*", "/media/*"]
  },
  // R2 bucket for photos uploaded from the admin page (flyers, gallery). Created automatically on deploy if missing.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "audiovox-media" }],
  // D1 database for the song-request list (fan songs and votes). Pinned by ID so every
  // deploy uses this exact database and can never create a new, empty one.
  // Deploys never change the data in it; the tables are created by worker/songs.js if missing.
  "d1_databases": [{ "binding": "DB", "database_name": "audiovox-songs", "database_id": "18abae3d-773c-4abb-b01e-320b01480aa5" }],
  // Keep the variables and secrets set in the Cloudflare dashboard
  // (RESEND_API_KEY, BOOKING_TO, BOOKING_FROM) when deploying from GitHub.
  "keep_vars": true,
  "observability": { "enabled": true }
}
